{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // vite/client is what types import.meta.glob, used by src/content/loadSets.ts
    "types": ["node", "vitest/globals", "vite/client"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,

    "resolveJsonModule": true,
    // De edge function draait op Deno en importeert met de .ts erbij, zoals Deno
    // wil. Met noEmit is dat hier alleen een leesregel (ADR-123).
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src",
    "e2e",
    "tools",
    "supabase",
    "vite.config.ts",
    "playwright.config.ts",
    "tailwind.config.ts"
  ]
}
